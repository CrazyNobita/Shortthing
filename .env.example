# ══════════════════════════════════════════════════════════════
# ProviderBotz — ShortnerBypass Configuration (.env.example)
# ══════════════════════════════════════════════════════════════

# Telegram Public Bot Credentials (from @BotFather)
BOT_TOKEN=
BOT_USERNAME=TheLinkzoBot
OWNER_ID=

# Telegram API & Telethon Userbot Credentials (from my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# External Bypass Bots (Only DZHQ and Alex DM allowed)
DZHQ_BOT_USERNAME=@DZHQ_BypassBot
ALEX_BOT_USERNAME=@alexbypassbot

# Force Subscribe Channel
FSUB_CHANNEL=@ProviderBotz

# Web Server & Public Mini App Configuration
# Leave blank to auto-detect dynamically with Cloudflare Quick Tunnel / APP_URL / host request!
PUBLIC_URL=
PORT=5000

# Security & Admin Access
SECRET_KEY=
ADMIN_PASSWORD=ProviderPro

# Timeout Configurations (seconds)
BYPASS_IDLE_TIMEOUT_SEC=30
ALEX_DM_TIMEOUT_SEC=75
MAX_BYPASS_TIMEOUT_SEC=120

# Rate Limiting & User Concurrency
RATE_LIMIT_SECONDS=3
MAX_CONCURRENT_PER_USER=2

# Debugging & Tracing (set to true for detailed bot messaging logs)
TRACE_BOTS=false
